{
  "schemaVersion": 1,
  "id": "kierangill.istat-cpu",
  "name": "iStat CPU",
  "version": "3.0.0",
  "author": "Kieran Gill",
  "description": "iStat Menus-style CPU history graph with a drop-down breakdown, per-core bars, and top processes",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Widget.qml" },
  "barWidget": {
    "displayName": "iStat CPU",
    "description": "CPU history graph + percentage; click for user/system/nice breakdown, cores, load, and top processes",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "interval": 2000, "showText": true, "topProcs": 5 },
    "schema": [
      { "key": "interval", "type": "number", "label": "Refresh interval (ms)" },
      { "key": "showText", "type": "boolean", "label": "Show percentage" },
      { "key": "topProcs", "type": "number", "label": "Processes to list" }
    ]
  }
}
